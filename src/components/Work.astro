---
import { work } from '../data/work';

const facts = [
  { value: '9+ years', label: 'embedded systems' },
  { value: '6+ years', label: 'vision and edge AI' },
  { value: 'IEEE Access', label: 'published research' },
  { value: 'São Paulo', label: 'Brazil' },
];
---

<section id="work" class="border-b border-rule" aria-labelledby="work-title">
  <header class="border-b border-rule px-5 py-8 sm:px-7">
    <h2 id="work-title" class="section-title">Selected work</h2>
  </header>

  <ul class="grid grid-cols-1 gap-px bg-rule sm:grid-cols-2 lg:grid-cols-3">
    {work.map((item, index) => (
      <li class="flex flex-col bg-bg px-5 py-7 sm:px-7">
        <p class="label">{String(index + 1).padStart(2, '0')} / {item.industry}</p>
        <h3 class="mt-3 font-serif text-xl leading-snug">{item.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">{item.description}</p>
        {item.link && (
          <a
            href={item.link.href}
            class="mt-3 self-start font-mono text-xs text-accent underline underline-offset-4"
            target="_blank"
            rel="noopener noreferrer"
          >
            {item.link.label}
          </a>
        )}
        <p class="mt-auto pt-4 font-mono text-xs text-accent">{item.stack.join(' · ')}</p>
      </li>
    ))}
  </ul>

  <!-- Facts row -->
  <dl class="grid grid-cols-2 gap-px border-t border-rule bg-rule lg:grid-cols-4">
    {facts.map((fact) => (
      <div class="flex flex-col-reverse bg-bg px-5 py-4 font-mono sm:px-7">
        <dt class="text-xs text-muted">{fact.label}</dt>
        <dd class="text-sm font-medium">{fact.value}</dd>
      </div>
    ))}
  </dl>
</section>
