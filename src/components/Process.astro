---
import SectionHeader from './SectionHeader.astro';
import { steps, engagements, clients } from '../data/process';
---

<section id="process" class="border-b border-rule" aria-labelledby="process-title">
  <SectionHeader index="03" id="process-title" title="How we work" />

  <!-- Steps -->
  <ol class="grid grid-cols-1 gap-px bg-rule sm:grid-cols-2 lg:grid-cols-4">
    {steps.map((step, index) => (
      <li class="paper px-5 py-7 sm:px-7">
        <p class="label">Step {index + 1}</p>
        <h3 class="mt-3 font-serif text-xl leading-snug">{step.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">{step.text}</p>
      </li>
    ))}
  </ol>

  <!-- Engagement types -->
  <div class="border-t border-rule">
    <h3 class="label border-b border-rule px-5 py-3 sm:px-7">Ways to work with us</h3>
    <ul class="grid grid-cols-1 gap-px bg-rule md:grid-cols-3">
      {engagements.map((engagement) => (
        <li class="paper px-5 py-6 sm:px-7">
          <h4 class="font-serif text-lg leading-snug">{engagement.title}</h4>
          <p class="mt-2 text-sm leading-relaxed text-muted">{engagement.text}</p>
        </li>
      ))}
    </ul>
  </div>

  <!-- Client types -->
  <div class="border-t border-rule">
    <h3 class="label border-b border-rule px-5 py-3 sm:px-7">Who we work with</h3>
    <ul class="grid grid-cols-1 gap-px bg-rule sm:grid-cols-2 lg:grid-cols-4">
      {clients.map((client) => (
        <li class="paper px-5 py-6 sm:px-7">
          <h4 class="font-serif text-lg leading-snug">{client.title}</h4>
          <p class="mt-2 text-sm leading-relaxed text-muted">{client.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
