<!-- Hidden until its script runs, so it is never a dead button without JavaScript -->
<button id="theme-toggle" type="button" class="btn px-2.5" aria-label="Dark theme" aria-pressed="false" hidden>
  <svg viewBox="0 0 16 16" class="h-4 w-4" aria-hidden="true">
    <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor"></path>
  </svg>
</button>

<script>
  const button = document.getElementById('theme-toggle');
  const root = document.documentElement;

  if (button) {
    const sync = () => button.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));

    button.hidden = false;
    sync();

    button.addEventListener('click', () => {
      const dark = root.dataset.theme !== 'dark';
      if (dark) {
        root.dataset.theme = 'dark';
      } else {
        delete root.dataset.theme;
      }
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch (e) {
        // Storage is unavailable; the choice lasts for this page only.
      }
      sync();
    });
  }
</script>
