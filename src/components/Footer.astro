---
const year = new Date().getFullYear();

const links = [
  { href: 'https://github.com/sentialab', label: 'GitHub', external: true },
  { href: 'https://linkedin.com/company/sentialab', label: 'LinkedIn', external: true },
  { href: 'mailto:contact@sentialab.com', label: 'contact@sentialab.com', external: false },
];
---

<footer
  class="flex flex-col gap-3 px-5 py-5 font-mono text-xs text-muted sm:flex-row sm:items-center sm:justify-between sm:px-7"
>
  <p>SentiaLab &copy; {year} · São Paulo, Brazil</p>
  <ul class="flex flex-wrap gap-x-5 gap-y-2">
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          class="transition-colors hover:text-fg"
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</footer>
