---
import { Image } from 'astro:assets';
import logo from '../assets/sentialab.png';
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#services', label: 'Services' },
  { href: '/#about', label: 'About' },
];
---

<header class="sticky top-0 z-50 border-b border-rule bg-bg">
  <nav
    class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 px-5 py-3 sm:px-7"
    aria-label="Main navigation"
  >
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 font-serif text-lg">
      <Image src={logo} alt="" width={24} height={24} densities={[1, 2]} class="h-6 w-6 dark:invert" />
      SentiaLab
    </a>

    <!-- Section links: second row on phones, inline from 640px -->
    <ul class="order-last flex w-full gap-6 font-mono text-[13px] text-muted sm:order-none sm:ml-auto sm:w-auto">
      {links.map((link) => (
        <li>
          <a href={link.href} class="transition-colors hover:text-fg">{link.label}</a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <a href="/contact/" class="btn">Talk to us</a>
    </div>
  </nav>
</header>
