---
const details = [
  { label: 'Teaching', value: 'Introductory AI at university level, 2019 to 2022' },
  { label: 'Education', value: 'BSc in Control and Automation Engineering' },
  { label: 'Languages', value: 'English, Portuguese, Spanish, Dutch, French' },
];

const elsewhere = [
  { href: 'https://linkedin.com/in/caiopiccirillo', label: 'LinkedIn' },
  { href: 'https://github.com/sentialab', label: 'GitHub' },
];
---

<section id="about" class="border-b border-rule" aria-labelledby="about-title">
  <header class="border-b border-rule px-5 py-8 sm:px-7">
    <h2 id="about-title" class="section-title">About</h2>
  </header>

  <div class="grid md:grid-cols-[3fr_2fr]">
    <!-- Founder note -->
    <div class="px-5 py-8 sm:px-7 md:border-r md:border-rule">
      <p class="font-mono text-xs text-muted italic">
        Sentia, from the Latin <span lang="la">sentīre</span>: to feel, to perceive.
      </p>
      <div class="mt-5 max-w-[60ch] space-y-4 leading-relaxed">
        <p>
          I'm Caio Piccirillo, a mechatronics engineer based in São Paulo, Brazil. I have spent more than nine
          years building embedded systems and more than six specializing in computer vision and edge AI, in
          Brazil and the Netherlands.
        </p>
        <p>
          SentiaLab is how I take on that work independently. I cover the whole path: annotating data, training
          models, optimizing them for the target hardware and shipping the C++ that runs on the device. I design
          for the deployment constraints from the first day, rather than adapting a model afterwards.
        </p>
      </div>
    </div>

    <dl class="divide-y divide-rule border-t border-rule md:border-t-0">
      {details.map((detail) => (
        <div class="px-5 py-4 sm:px-7">
          <dt class="label">{detail.label}</dt>
          <dd class="mt-1.5 font-mono text-[13px] leading-relaxed">{detail.value}</dd>
        </div>
      ))}
      <div class="px-5 py-4 sm:px-7">
        <dt class="label">Elsewhere</dt>
        <dd class="mt-1.5 flex gap-5 font-mono text-[13px]">
          {elsewhere.map((link) => (
            <a
              href={link.href}
              class="text-accent underline underline-offset-4"
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.label}
            </a>
          ))}
        </dd>
      </div>
    </dl>
  </div>
</section>
