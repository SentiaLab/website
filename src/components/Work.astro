---
import SectionHeader from './SectionHeader.astro';
import { clientWork, earlierWork, type WorkItem } from '../data/work';

const groups: { label: string; note?: string; items: WorkItem[] }[] = [
  { label: 'Client work', items: clientWork },
  {
    label: 'Earlier engineering experience',
    note: 'Delivered by our founder before SentiaLab.',
    items: earlierWork,
  },
];

const facts = [
  { label: 'Sectors', value: 'Transportation, healthcare, industry' },
  { label: 'Deployment', value: 'Edge, on-premises, cloud' },
  { label: 'Delivery', value: 'Remote, worldwide' },
  { label: 'Based in', value: 'São Paulo, Brazil' },
];
---

<section id="work" class="border-b border-rule" aria-labelledby="work-title">
  <SectionHeader index="01" id="work-title" title="Selected work" />

  {groups.map((group) => (
    <div class="border-b border-rule">
      <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-rule px-5 py-3 sm:px-7">
        <h3 class="label">{group.label}</h3>
        {group.note && <p class="font-mono text-xs text-muted">{group.note}</p>}
      </div>

      <ul class="grid grid-cols-1 gap-px bg-rule sm:grid-cols-2 lg:grid-cols-3">
        {group.items.map((item) => (
          <li class="flex flex-col paper px-5 py-7 sm:px-7">
            <p class="label">{item.sector}</p>
            <h4 class="mt-3 font-serif text-xl leading-snug">{item.title}</h4>
            <p class="mt-2 text-sm leading-relaxed text-muted">{item.description}</p>
            {item.link && (
              <a
                href={item.link.href}
                class="mt-3 self-start font-mono text-xs text-accent underline underline-offset-4"
                target="_blank"
                rel="noopener noreferrer"
              >
                {item.link.label}
              </a>
            )}
            <p class="mt-auto pt-4 font-mono text-xs text-accent">{item.stack.join(' · ')}</p>
          </li>
        ))}
      </ul>
    </div>
  ))}

  <!-- Company facts -->
  <dl class="grid grid-cols-2 gap-px bg-rule lg:grid-cols-4">
    {facts.map((fact) => (
      <div class="paper px-5 py-4 font-mono sm:px-7">
        <dt class="text-xs text-muted">{fact.label}</dt>
        <dd class="mt-1 text-[13px] font-medium">{fact.value}</dd>
      </div>
    ))}
  </dl>
</section>
