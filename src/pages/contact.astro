---
import Layout from '../layouts/Layout.astro';

const channels = [
  { label: 'Email', value: 'contact@sentialab.com', href: 'mailto:contact@sentialab.com', external: false },
  { label: 'GitHub', value: 'github.com/sentialab', href: 'https://github.com/sentialab', external: true },
  { label: 'LinkedIn', value: 'SentiaLab', href: 'https://linkedin.com/company/sentialab', external: true },
];

const field =
  'w-full rounded-[3px] border border-rule-strong bg-surface px-3.5 py-2.5 text-fg placeholder:text-muted transition-colors focus:border-accent focus:ring-1 focus:ring-accent focus:outline-none';
---

<Layout
  title="Contact | SentiaLab"
  description="Start a project with SentiaLab: edge AI, computer vision and embedded systems engineering."
>
  <section class="border-b border-rule px-5 py-12 sm:px-7 sm:py-16">
    <h1 class="font-serif text-4xl leading-tight">Start a project</h1>
    <p class="mt-3 text-muted">Tell me what you are building and where it has to run.</p>
  </section>

  <section class="grid border-b border-rule md:grid-cols-[2fr_3fr]">
    <!-- Contact Info -->
    <dl class="divide-y divide-rule md:border-r md:border-rule">
      {channels.map((channel) => (
        <div class="px-5 py-4 sm:px-7">
          <dt class="label">{channel.label}</dt>
          <dd class="mt-1.5 font-mono text-[13px]">
            <a
              href={channel.href}
              class="text-accent underline underline-offset-4"
              target={channel.external ? '_blank' : undefined}
              rel={channel.external ? 'noopener noreferrer' : undefined}
            >
              {channel.value}
            </a>
          </dd>
        </div>
      ))}
      <div class="px-5 py-4 sm:px-7">
        <dt class="label">Location</dt>
        <dd class="mt-1.5 font-mono text-[13px]">São Paulo, Brazil</dd>
      </div>
    </dl>

    <!-- Contact Form -->
    <form
      id="contact-form"
      action="https://api.web3forms.com/submit"
      method="POST"
      class="space-y-5 border-t border-rule px-5 py-8 sm:px-7 md:border-t-0"
      novalidate
    >
      <input type="hidden" name="access_key" value="bb7506a4-bf32-4545-b018-fa7da8c297f1" />
      <div>
        <label for="name" class="label mb-2 block">Name</label>
        <input type="text" id="name" name="name" required minlength="2" class={field} placeholder="Your name" />
        <p class="form-error mt-1.5 hidden font-mono text-xs text-danger"></p>
      </div>

      <div>
        <label for="email" class="label mb-2 block">Email</label>
        <input type="email" id="email" name="email" required class={field} placeholder="your@email.com" />
        <p class="form-error mt-1.5 hidden font-mono text-xs text-danger"></p>
      </div>

      <div>
        <label for="subject" class="label mb-2 block">Subject</label>
        <input type="text" id="subject" name="subject" class={field} placeholder="Project inquiry" />
      </div>

      <div>
        <label for="message" class="label mb-2 block">Message</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          minlength="10"
          class:list={[field, 'resize-none']}
          placeholder="Tell me about your project..."></textarea>
        <p class="form-error mt-1.5 hidden font-mono text-xs text-danger"></p>
      </div>

      <!-- Success/Error Messages -->
      <div
        id="form-success"
        role="status"
        class="hidden rounded-[3px] border border-accent px-4 py-3 font-mono text-xs text-accent"
      >
        Message sent. I'll get back to you soon.
      </div>
      <div
        id="form-global-error"
        role="alert"
        class="hidden rounded-[3px] border border-danger px-4 py-3 font-mono text-xs text-danger"
      >
        Something went wrong. Please try again or email me directly.
      </div>

      <button
        type="submit"
        id="submit-btn"
        class="btn btn-primary w-full py-2.5 disabled:cursor-not-allowed disabled:opacity-50"
      >
        <span id="submit-text">Send message</span>
        <svg id="submit-spinner" class="hidden h-4 w-4 animate-spin" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
        </svg>
      </button>

      <p class="font-mono text-xs text-muted">I usually reply within 24 hours.</p>
    </form>
  </section>
</Layout>

<script>
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    if (!form) return;

    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const submitText = document.getElementById('submit-text');
    const submitSpinner = document.getElementById('submit-spinner');
    const successMsg = document.getElementById('form-success');
    const globalError = document.getElementById('form-global-error');

    function validateField(input: HTMLInputElement | HTMLTextAreaElement): string {
      if (input.required && !input.value.trim()) {
        return `${input.labels?.[0]?.textContent || 'This field'} is required.`;
      }
      if (input.type === 'email' && input.value) {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(input.value)) return 'Please enter a valid email address.';
      }
      if (input.minLength > 0 && input.value.length < input.minLength) {
        return `Must be at least ${input.minLength} characters.`;
      }
      return '';
    }

    function showFieldError(input: HTMLInputElement | HTMLTextAreaElement, message: string) {
      const errorEl = input.parentElement?.querySelector('.form-error');
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.classList.remove('hidden');
      }
      input.classList.add('border-danger');
      input.classList.remove('border-rule-strong');
    }

    function clearFieldError(input: HTMLInputElement | HTMLTextAreaElement) {
      const errorEl = input.parentElement?.querySelector('.form-error');
      if (errorEl) {
        errorEl.textContent = '';
        errorEl.classList.add('hidden');
      }
      input.classList.remove('border-danger');
      input.classList.add('border-rule-strong');
    }

    // Real-time validation on blur
    form.querySelectorAll('input, textarea').forEach((field) => {
      field.addEventListener('blur', () => {
        const input = field as HTMLInputElement | HTMLTextAreaElement;
        const error = validateField(input);
        if (error) {
          showFieldError(input, error);
        } else {
          clearFieldError(input);
        }
      });

      field.addEventListener('input', () => {
        clearFieldError(field as HTMLInputElement | HTMLTextAreaElement);
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      successMsg?.classList.add('hidden');
      globalError?.classList.add('hidden');

      // Validate all fields
      let hasErrors = false;
      form.querySelectorAll('input[required], textarea[required]').forEach((field) => {
        const input = field as HTMLInputElement | HTMLTextAreaElement;
        const error = validateField(input);
        if (error) {
          showFieldError(input, error);
          hasErrors = true;
        }
      });

      if (hasErrors) return;

      // Show loading state
      submitBtn.disabled = true;
      if (submitText) submitText.textContent = 'Sending...';
      submitSpinner?.classList.remove('hidden');

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          form.reset();
          successMsg?.classList.remove('hidden');
        } else {
          globalError?.classList.remove('hidden');
        }
      } catch {
        globalError?.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        if (submitText) submitText.textContent = 'Send message';
        submitSpinner?.classList.add('hidden');
      }
    });
  }

  initContactForm();
</script>
